# EditorConfig + ktlint-friendly defaults.
# Mantém indentação consistente entre IDEs e o CI ktlint.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.{xml,gradle,toml}]
indent_size = 4

# ktlint 12.1.0 tem regras de Kotlin Script (.kts) que disparam em
# expressoes multi-linha. Como os build.gradle.kts sao poucos e
# revisados a mao, nao rodamos ktlint neles.
[*.kts]
ktlint = disabled

[*.md]
trim_trailing_whitespace = false
# Desabilita regras ktlint muito agressivas em *.kt (multiline-expression
# quebra QUALQUER chamada de funcao multi-linha, nao apenas .kts).
[*.kt]
ktlint_standard_multiline-expression = disabled
ktlint_standard_newline-before-expression-body = disabled
ktlint_standard_property-wrapping = disabled
