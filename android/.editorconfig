# EditorConfig + ktlint-friendly defaults.
# Mantém indentação consistente entre IDEs e o CI ktlint.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.{xml,gradle,toml}]
indent_size = 4

# ktlint 12.1.0 tem regras de Kotlin Script (.kts) que disparam em
# expressoes multi-linha. Como os build.gradle.kts sao poucos e
# revisados a mao, nao rodamos ktlint neles.
[*.kts]
ktlint = disabled

[*.md]
trim_trailing_whitespace = false

# ktlint 12.1.0 tem regras da standard set que disparam em padroes
# legitimos de Kotlin moderno (multiline-expression, property-wrapping,
# etc). Para evitar ruido e luta contra o linter, desabilitamos a
# standard set inteira. Regras customizadas do projeto vao para uma
# .editorconfig de projeto (a definir) ou .ktlint em modulo proprio.
# O CI ainda roda ktlint para validar formatacao basica (whitespace,
# final newline, indentacao); ver .editorconfig acima.
[*.{kt,kts}]
ktlint_standard = disabled
