# Exemplo de variáveis de ambiente. Copie para .env e edite.
# .env NUNCA vai para o repositório (R12).

# Banco de dados
DATABASE_URL=sqlite:///./brainoutapp.db

# JWT — gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-32-chars-min-aaaaaaaaaaaa
JWT_EXPIRES_MIN=60

# Bcrypt cost (>=12 conforme política de senhas, R-SEG)
BCRYPT_ROUNDS=12

# CORS (separar por vírgula)
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:3000

# Integração externa (issue #15)
EXTERNAL_API_TIMEOUT_S=5
EXTERNAL_API_BASE_URL=https://brasilapi.com.br/api

# Log level
LOG_LEVEL=INFO