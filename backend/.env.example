# Exemplo de variáveis de ambiente. Copie para .env e edite.
# .env NUNCA vai para o repositório (R12).

# Banco de dados
DATABASE_URL=sqlite:///./dev.db

# JWT
JWT_SECRET=trocar-por-um-segredo-aleatorio-de-32-chars-min
JWT_EXPIRES_MIN=60

# CORS (separar por vírgula)
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:3000

# Integração externa (issue #15)
EXTERNAL_API_TIMEOUT_S=5
EXTERNAL_API_BASE_URL=https://brasilapi.com.br/api

# Log level
LOG_LEVEL=INFO
